rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Public connectivity check; no user data is stored here.
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Public question bank. Only trusted server/Admin SDK processes may write.
    match /mpsc_questions/{questionId} {
      allow read: if true;
      allow write: if isAdmin() && isValidId(questionId);
    }

    // A user's profile and nested records are private to that authenticated UID.
    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId) && isValidId(userId);

      match /examResults/{resultId} {
        allow read, create, update, delete: if isOwner(userId) && isValidId(resultId);
      }

      match /studyLogs/{logId} {
        allow read, create, update, delete: if isOwner(userId) && isValidId(logId);
      }
    }

    // Deny all unlisted collections/documents by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
