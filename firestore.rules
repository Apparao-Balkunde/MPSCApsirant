rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health/connection test document
    match /test/connection {
      allow read: if true;
    }

    // Global MPSC question bank stored on Firestore
    match /mpsc_questions/{questionId} {
      allow read: if true;
      allow write: if isValidId(questionId);
    }

    // Curated daily quiz questions pool
    match /daily_questions/{questionId} {
      allow read: if true;
      allow write: if isValidId(questionId);
    }

    // Daily quiz live leaderboard per calendar date
    match /daily_quiz_leaderboard/{date}/attempts/{attemptId} {
      allow read: if true;
      allow write: if isValidId(attemptId);
    }

    // Exam live leaderboard per examId / pattern
    match /exam_leaderboards/{examId}/attempts/{attemptId} {
      allow read: if true;
      allow write: if isValidId(attemptId);
    }

    // Aspirant user profile
    match /users/{userId} {
      allow read: if true;
      allow write: if isValidId(userId);

      // Exam results subcollection
      match /examResults/{resultId} {
        allow read: if true;
        allow write: if isValidId(resultId);
      }

      // Study logs subcollection
      match /studyLogs/{logId} {
        allow read: if true;
        allow write: if isValidId(logId);
      }

      // Daily quiz attempt subcollection (strictly one quiz per day per user)
      match /dailyQuizAttempts/{attemptId} {
        allow read: if true;
        allow write: if isValidId(attemptId);
      }
    }
  }
}

